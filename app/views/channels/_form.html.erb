<%= form_with model: channel, url: form_url, class: "form" do |f| %>
  <% if channel.errors.any? %>
    <div class="flash alert">
      <strong><%= pluralize(channel.errors.count, "error") %> prevented this channel from being saved:</strong>
      <ul>
        <% channel.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :channel_type %>
    <%= f.select :channel_type, Channel.channel_types.keys.map { |k| [k.humanize, k] } %>
  </div>

  <div>
    <%= f.label :link, "Link / URL" %>
    <%= f.text_field :link %>
  </div>

  <div>
    <%= f.label :contact_name %>
    <%= f.text_field :contact_name %>
  </div>

  <div>
    <%= f.label :contact_email %>
    <%= f.text_field :contact_email %>
  </div>

  <div>
    <%= f.label :cv_version, "CV version used" %>
    <%= f.text_field :cv_version %>
  </div>

  <div>
    <%= f.label :material, "Attach material (CV / cover letter)" %>
    <%= f.file_field :material %>
  </div>

  <div class="actions">
    <%= f.submit %>
  </div>
<% end %>
